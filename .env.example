# Copy to .env and adjust as needed. All values are optional.

# Server
PORT=3030
MAX_CONCURRENT_DOWNLOADS=2

# Downloads (bytes unless noted)
SEGMENT_MIN_SIZE=83886080
SEGMENTS=8
CHUNK_SIZE=16777216
STALL_TIMEOUT_MS=30000
DOWNLOAD_RETRIES=2

# Browser
DOUYIN_BROWSER_PATH=
BROWSER_IDLE_TIMEOUT_MS=120000

# Channel (profile) tab
PROFILE_MAX_VIDEOS=200

# Optional Cloudflare Worker edge cache (see cloudflare-worker/README.md)
CLOUDFLARE_WORKER_URL=
CLOUDFLARE_WORKER_SECRET=
